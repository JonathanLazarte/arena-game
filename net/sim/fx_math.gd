## Raíz cuadrada entera (floor) por Newton; n >= 0.
static func isqrt(n: int) -> int:
	if n <= 0:
		return 0
	var x := n
	var y := (x + 1) >> 1
	while y < x:
		x = y
		y = (x + n / x) >> 1
	return x

static func length(x: int, z: int) -> int:
	return isqrt(x * x + z * z)

## Índice de rumbo (0..255) más cercano al vector (x, z); (0,0) -> fallback.
static func dir_of(x: int, z: int, fallback: int = 0) -> int:
	if x == 0 and z == 0:
		return fallback
	# cuadrante: rota el vector hasta x > 0, z >= 0
	var q := 0
	while not (x > 0 and z >= 0):
		var t := x
		x = z
		z = -t
		q += 1
	# búsqueda binaria del índice i en [0, 64] donde cross(dir_i, v) cambia de signo
	var lo := 0
	var hi := 64
	while hi - lo > 1:
		var mid := (lo + hi) >> 1
		if COS[mid] * z - SIN[mid] * x >= 0:
			lo = mid
		else:
			hi = mid
	var dlo: int = COS[lo] * x + SIN[lo] * z
	var dhi: int = COS[hi] * x + SIN[hi] * z
	var i: int = lo if dlo >= dhi else hi
	return (i + q * 64) & 255

## Diferencia con signo b - a en rumbos (-128..127).
static func ddiff(a: int, b: int) -> int:
	return ((b - a + 128) & 255) - 128

## Gira a hacia b como mucho `step` rumbos.
static func turn_toward(a: int, b: int, step: int) -> int:
	var d := ddiff(a, b)
	if d > step:
		d = step
	elif d < -step:
		d = -step
	return (a + d) & 255
