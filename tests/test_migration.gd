extends SceneTree
var fails: int = 0
func _initialize() -> void:
	_run()
func check(cond: bool, msg: String) -> void:
	print(("PASS  " if cond else "FAIL  ") + msg)
	if not cond:
		fails += 1
func finish() -> void:
	print("RESULT: ", "OK" if fails == 0 else "FALLO", " (%d fallos)" % fails)
	quit(1 if fails > 0 else 0)
func fresh(gs: Node, path: String) -> void:
	gs.save_path = path
	DirAccess.remove_absolute(ProjectSettings.globalize_path(path))
	gs.reset_defaults()

## Ronda 11: migración del guardado v1 (ronda 10) a v2.
func _run() -> void:
	await process_frame
	var gs := root.get_node("GameState")
	fresh(gs, "user://test_migration.cfg")
	var v1 := ConfigFile.new()
	v1.set_value("jugador", "nombre", "Pollo")
	v1.set_value("jugador", "oro", 1250)
	v1.set_value("loadout", "character_id", "asesino")
	v1.set_value("loadout", "weapon_id", "espada_larga")
	v1.set_value("loadout", "eikon_id", "golem")
	v1.set_value("loadout", "mount_id", "grifo")
	v1.set_value("loadout", "difficulty", "dificil")
	v1.save(gs.save_path)
	gs.load_loadout()
	check(gs.migrated_from == 1, "detecta guardado v1")
	check(gs.first_run_done, "no vuelve a pedir la elección")
	check(gs.player_name == "Pollo" and gs.oro == 1250 and gs.difficulty == "dificil", "conserva nombre, oro y dificultad (grifo canjeado, sin reembolso)")
	check(gs.unlocked_chars == ["asesino"] and gs.character_id == "asesino", "desbloquea solo el personaje que usaba")
	check(gs.weapon_id == "espada_larga" and gs.is_unlocked("weapon", "espada_larga") and gs.is_unlocked("weapon", "dagas"), "conserva su arma equipada y la por defecto")
	check(gs.eikon_id == "golem" and "golem" in gs.owned_eikons and "grifo" in gs.owned_eikons, "no pierde eikon; su montura grifo pasa a ser el eikon grifo")
	check(gs.account_xp == 0 and gs.account_level() == 1, "progresión empieza en nivel 1")
	var cfg := ConfigFile.new()
	cfg.load(gs.save_path)
	check(cfg.get_value("meta", "version", 0) == gs.SAVE_VERSION and not cfg.has_section_key("loadout", "mount_id") and cfg.get_value("slot_0", "character_id") == "asesino", "reescribe el archivo como v%d (sin monturas, ranura 0)" % gs.SAVE_VERSION)
	gs.reset_defaults()
	gs.load_loadout()
	check(gs.migrated_from == 0 and gs.character_id == "asesino" and gs.oro == 1250, "segunda carga: v4 directo, sin migrar otra vez")
	# Guardado v1 con personaje inválido
	var bad := ConfigFile.new()
	bad.set_value("loadout", "character_id", "dragon")
	bad.save(gs.save_path)
	gs.reset_defaults()
	gs.load_loadout()
	check(gs.first_run_done and gs.unlocked_chars == ["caballero"] and gs.character_id == "caballero", "v1 corrupto: cae en Caballero")
	# --- Ronda 14: guardado v2 con monturas -> v3 (eikons) ---
	var v2 := ConfigFile.new()
	v2.set_value("meta", "version", 2)
	v2.set_value("jugador", "oro", 100)
	v2.set_value("loadout", "character_id", "caballero")
	v2.set_value("loadout", "eikon_id", "lobo")
	v2.set_value("loadout", "mount_id", "unicornio")
	v2.set_value("progreso", "first_run_done", true)
	v2.set_value("progreso", "account_xp", 5000)
	v2.set_value("progreso", "unlocked_chars", ["caballero"])
	v2.set_value("progreso", "owned_weapons", ["espada_escudo"])
	v2.set_value("progreso", "owned_eikons", ["fenix", "lobo"])
	v2.set_value("progreso", "owned_mounts", ["caballo", "unicornio", "grifo"])
	v2.save(gs.save_path)
	gs.reset_defaults()
	gs.load_loadout()
	check(gs.migrated_from == 2, "detecta guardado v2")
	check("grifo" in gs.owned_eikons and gs.owned_eikons.has("lobo") and gs.eikon_id == "lobo", "montura grifo -> eikon grifo; conserva sus eikons")
	check(gs.oro == 100 + Progression.MOUNT_REFUND["unicornio"], "el unicornio (eliminado) devuelve su oro (%d)" % gs.oro)
	check(gs.mount_migration.get("refund", 0) == 500 and "grifo" in gs.mount_migration.get("eikons", []), "resumen de la migración")
	check(gs.account_xp == 5000 and gs.first_run_done, "conserva la progresión")
	var c3 := ConfigFile.new()
	c3.load(gs.save_path)
	check(c3.get_value("meta", "version", 0) == gs.SAVE_VERSION and not c3.has_section_key("progreso", "owned_mounts") and not c3.has_section_key("loadout", "mount_id"), "reescrito como v4 sin claves de montura")
	gs.reset_defaults()
	gs.load_loadout()
	check(gs.migrated_from == 0 and gs.oro == 600, "recargar v3 no reembolsa dos veces")
	# --- Ronda 15: v3 con varios personajes -> v4 (uno por ranura, reembolso de los extra) ---
	var v3 := ConfigFile.new()
	v3.set_value("meta", "version", 3)
	v3.set_value("jugador", "oro", 40)
	v3.set_value("loadout", "character_id", "berserker")
	v3.set_value("loadout", "weapon_id", "hacha_2m")
	v3.set_value("loadout", "eikon_id", "fenix")
	v3.set_value("progreso", "first_run_done", true)
	v3.set_value("progreso", "account_xp", 900)
	v3.set_value("progreso", "char_xp", {"caballero": 300, "berserker": 700, "paladin": 50})
	v3.set_value("progreso", "skills", {"berserker": ["ber_furia"], "caballero": ["cab_resistencia"]})
	v3.set_value("progreso", "unlocked_chars", ["caballero", "berserker", "paladin"])
	v3.set_value("progreso", "owned_weapons", ["espada_escudo", "hacha_2m"])
	v3.set_value("progreso", "owned_eikons", ["fenix"])
	v3.save(gs.save_path)
	gs.reset_defaults()
	gs.load_loadout()
	var exp_refund: int = Progression.LEGACY_CHARACTER_PRICE["caballero"] + Progression.LEGACY_CHARACTER_PRICE["paladin"]
	check(gs.migrated_from == 3, "detecta guardado v3")
	check(gs.character_id == "berserker" and gs.unlocked_chars == ["berserker"] and gs.weapon_id == "hacha_2m", "conserva solo el personaje seleccionado")
	check(gs.oro == 40 + exp_refund and gs.char_migration.get("refund", 0) == exp_refund, "reembolsa el oro de los personajes extra (%d)" % gs.oro)
	check(gs.char_xp.get("berserker", 0) == 700 and gs.char_skills() == ["ber_furia"] and gs.account_xp == 900, "conserva XP y habilidades del personaje y la cuenta")
	check(not gs.char_xp.has("caballero") and not gs.skills.has("caballero"), "descarta el progreso de los extra")
	var c4 := ConfigFile.new()
	c4.load(gs.save_path)
	check(c4.get_value("meta", "version", 0) >= 5 and c4.has_section_key("slot_0", "attrs") and c4.get_value("slot_0", "character_id") == "berserker" and c4.get_value("slot_0", "xp") == 700 and not c4.has_section_key("progreso", "unlocked_chars"), "v4: datos del personaje en la ranura 0")
	gs.reset_defaults()
	gs.load_loadout()
	check(gs.migrated_from == 0 and gs.oro == 40 + exp_refund and gs.character_id == "berserker" and gs.char_skills() == ["ber_furia"], "recargar v4 no reembolsa dos veces y conserva todo")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(gs.save_path))
	finish()
